{
  "Comment": "Dual-field reindex: ECS for heavy tasks, Lambda for light tasks. Per-chunk guarantee eliminates outer retry loop.",
  "StartAt": "Prepare",
  "States": {
    "Prepare": {
      "Type": "Task",
      "Resource": "${PrepareFunctionArn}",
      "ResultPath": "$.prepare_result",
      "Next": "WaitBeforeExtract",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }]
    },

    "WaitBeforeExtract": {
      "Type": "Wait",
      "Seconds": 130,
      "Comment": "Wait 2 AOSS refresh cycles (~60s each) so PIT captures all docs",
      "Next": "ExtractTexts"
    },

    "ExtractTexts": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "TimeoutSeconds": 14400,
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${ECSClusterArn}",
        "TaskDefinition": "${ECSTaskDefinitionArn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${SubnetIds}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "Cpu.$": "$.prepare_result.ecs_cpu",
          "Memory.$": "$.prepare_result.ecs_memory",
          "ContainerOverrides": [{
            "Name": "main",
            "Environment": [
              { "Name": "TASK_TYPE", "Value": "extract_texts" },
              { "Name": "COLLECTION_ENDPOINT", "Value.$": "$.collection_endpoint" },
              { "Name": "INDEX_NAME", "Value.$": "$.index_name" },
              { "Name": "V2_FIELD", "Value.$": "$.v2_field" },
              { "Name": "TEXT_FIELD", "Value.$": "$.text_field" },
              { "Name": "S3_BUCKET", "Value.$": "$.s3_bucket" },
              { "Name": "S3_PREFIX", "Value.$": "$.s3_prefix" },
              { "Name": "CHUNK_SIZE", "Value.$": "States.Format('{}', $.prepare_result.chunk_size)" },
              { "Name": "ENCRYPTION_KEY", "Value": "shanghaiopensearchFINETUNETASK" }
            ]
          }]
        }
      },
      "ResultPath": "$.extract_ecs_result",
      "Next": "StartEmbeddingJob",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "ECS.AmazonECSException"],
          "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }]
    },

    "StartEmbeddingJob": {
      "Type": "Task",
      "Resource": "${StartEmbeddingJobFunctionArn}",
      "Parameters": {
        "s3_bucket.$": "$.s3_bucket",
        "s3_prefix.$": "$.s3_prefix",
        "sagemaker_role.$": "$.sagemaker_role",
        "embedding_model_name.$": "$.embedding_model_name",
        "collection_endpoint.$": "$.collection_endpoint",
        "index_name.$": "$.index_name",
        "v2_field.$": "$.v2_field",
        "text_field.$": "$.text_field",
        "pipeline_name.$": "$.pipeline_name",
        "search_pipeline_name.$": "$.search_pipeline_name",
        "model_id.$": "$.model_id",
        "v1_field.$": "$.v1_field",
        "chunk_size.$": "$.prepare_result.chunk_size"
      },
      "ResultPath": "$.job_result",
      "Next": "IsJobSkipped",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 60, "MaxAttempts": 10, "BackoffRate": 2.0,
          "Comment": "SageMaker quota may be temporarily exhausted — retry up to 10 times with exponential backoff"
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }]
    },

    "IsJobSkipped": {
      "Type": "Choice",
      "Comment": "If ExtractTexts found 0 docs, StartEmbeddingJob returns skipped=true.",
      "Choices": [
        { "Variable": "$.job_result.skipped", "BooleanEquals": true, "Next": "Switch" }
      ],
      "Default": "WaitForEmbeddingJob"
    },

    "WaitForEmbeddingJob": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CheckEmbeddingJob"
    },

    "CheckEmbeddingJob": {
      "Type": "Task",
      "Resource": "${CheckEmbeddingJobFunctionArn}",
      "InputPath": "$.job_result",
      "ResultPath": "$.job_status",
      "Next": "IsJobComplete",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }]
    },

    "IsJobComplete": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.job_status.completed", "BooleanEquals": true, "Next": "WriteEmbeddings" },
        { "Variable": "$.job_status.failed", "BooleanEquals": true, "Next": "Failed" }
      ],
      "Default": "WaitForEmbeddingJob"
    },

    "WriteEmbeddings": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "TimeoutSeconds": 43200,
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${ECSClusterArn}",
        "TaskDefinition": "${ECSTaskDefinitionArn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${SubnetIds}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "Cpu.$": "$.prepare_result.ecs_cpu",
          "Memory.$": "$.prepare_result.ecs_memory",
          "ContainerOverrides": [{
            "Name": "main",
            "Environment": [
              { "Name": "TASK_TYPE", "Value": "write_embeddings" },
              { "Name": "COLLECTION_ENDPOINT", "Value.$": "$.collection_endpoint" },
              { "Name": "INDEX_NAME", "Value.$": "$.index_name" },
              { "Name": "V2_FIELD", "Value.$": "$.v2_field" },
              { "Name": "S3_BUCKET", "Value.$": "$.s3_bucket" },
              { "Name": "S3_PREFIX", "Value.$": "$.s3_prefix" },
              { "Name": "ENCRYPTION_KEY", "Value": "shanghaiopensearchFINETUNETASK" },
              { "Name": "WRITE_CONCURRENCY", "Value.$": "States.Format('{}', $.prepare_result.write_concurrency)" }
            ]
          }]
        }
      },
      "ResultPath": "$.write_ecs_result",
      "Next": "WaitBeforeSwitch",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "ECS.AmazonECSException"],
          "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }]
    },

    "WaitBeforeSwitch": {
      "Type": "Wait",
      "Seconds": 65,
      "Comment": "Wait for AOSS refresh cycle so all written embeddings are searchable",
      "Next": "Switch"
    },

    "Switch": {
      "Type": "Task",
      "Resource": "${SwitchFunctionArn}",
      "Parameters": {
        "collection_endpoint.$": "$.collection_endpoint",
        "index_name.$": "$.index_name",
        "v2_field.$": "$.v2_field",
        "text_field.$": "$.text_field",
        "pipeline_name.$": "$.pipeline_name",
        "search_pipeline_name.$": "$.search_pipeline_name",
        "model_id.$": "$.model_id"
      },
      "ResultPath": "$.switch_result",
      "Next": "CleanOldField",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
          "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Failed" }]
    },

    "CleanOldField": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "TimeoutSeconds": 43200,
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${ECSClusterArn}",
        "TaskDefinition": "${ECSTaskDefinitionArn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${SubnetIds}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "Cpu.$": "$.prepare_result.ecs_cpu",
          "Memory.$": "$.prepare_result.ecs_memory",
          "ContainerOverrides": [{
            "Name": "main",
            "Environment": [
              { "Name": "TASK_TYPE", "Value": "clean_old_field" },
              { "Name": "COLLECTION_ENDPOINT", "Value.$": "$.collection_endpoint" },
              { "Name": "INDEX_NAME", "Value.$": "$.index_name" },
              { "Name": "OLD_FIELD", "Value.$": "$.v1_field" },
              { "Name": "WRITE_CONCURRENCY", "Value.$": "States.Format('{}', $.prepare_result.write_concurrency)" }
            ]
          }]
        }
      },
      "ResultPath": "$.clean_result",
      "Next": "Done",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "ECS.AmazonECSException"],
          "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2.0
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "Done" }]
    },

    "Done": {
      "Type": "Succeed",
      "Comment": "Workflow complete. Search is on v2, old field cleaned (best effort)."
    },

    "Failed": {
      "Type": "Fail",
      "Cause": "Reindex workflow failed",
      "Error": "ReindexError"
    }
  }
}
